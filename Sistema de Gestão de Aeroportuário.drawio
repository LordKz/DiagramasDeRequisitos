        <mxCell id="tLjfcElTsTrK4vd2UGkE-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Gestao Aeroportuária&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;O Sistema gerencia operações aeroportuárias, &lt;b&gt;permitindo que passageiros comprem passagens e realizem check-in,&lt;/b&gt; enquanto &lt;b&gt;companhias aéreas cadastram voos e gerenciam reservas&lt;/b&gt;.&lt;b&gt; A torre de controle autoriza pousos e decolagens e gerencia pistas&lt;/b&gt;, &lt;u&gt;&lt;b&gt;o Diagrama de Classes&lt;/b&gt;&lt;/u&gt; Inclui &lt;b&gt;Voo (ID, origem, Destino, horário, Status), Passagem (ID, assento, preço, Status), Passageiro (ID, Nome, Passaporte), Aeronave (ID, Modelo, Capacidade), Companhia Aérea (ID, Nome, Código ICAO) e Pista de Pouso (ID, número, Comprimento, Status), &lt;/b&gt;Garantido controle e segurança nas operações.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry width="560" height="160" as="geometry" />
        </mxCell>
